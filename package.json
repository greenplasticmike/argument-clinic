{
  "name": "argument-clinic",
  "version": "0.1.0",
  "description": "Persona-based conversation simulator using LLMs",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "argument-clinic": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "llm",
    "debate",
    "simulation",
    "ai",
    "persona"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "commander": "^12.1.0",
    "dotenv": "^17.2.3",
    "openai": "^4.73.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.16.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.17.0",
    "vitest": "^2.1.0"
  }
}
